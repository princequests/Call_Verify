
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for CallVerify API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Phone state -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- Notifications and foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="CallVerify Receiver"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CallVerifyReceiver">

        <!-- Main CallVerify dashboard -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Android call screening service -->
        <service
            android:name=".CallVerifyScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">

            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>

        </service>

    </application>

</manifest>
